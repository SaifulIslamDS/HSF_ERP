# Application
NODE_ENV=development
APP_NAME=HSF ERP
APP_TIMEZONE=Asia/Dhaka
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=hsf_erp
POSTGRES_USER=hsf
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://hsf:change-me-locally@localhost:5432/hsf_erp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication placeholders — generate secure values locally
AUTH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-secret

# Worker
WORKER_ENABLED=false

# Temporary HSF ERP management-preview PIN gate
# Set the actual 6-digit PIN in Netlify. Never commit the real PIN.
# In production the gate fails closed if the PIN is missing or invalid.
HSF_ERP_ACCESS_GATE_ENABLED=
HSF_ERP_ACCESS_PIN=
# Required when the preview gate is enabled unless AUTH_SECRET is an independent strong server secret.
# Minimum 32 characters; must not equal the PIN; never commit the real value.
# The PIN is never used as a signing-secret fallback.
HSF_ERP_ACCESS_SECRET=
HSF_ERP_ACCESS_SESSION_HOURS=12
HSF_ERP_ACCESS_IDLE_MINUTES=30
