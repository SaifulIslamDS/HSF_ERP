  "http_failure_contract": {
    "401": "missing or invalid authenticated session",
    "403": "authenticated but unauthorized by a scope, status or privilege check",
    "404": "missing or resource existence withheld by approved policy",
    "409": "workflow version/idempotency conflict",
    "500": "internal failure; no sensitive data leakage"
  },
  "application_boundary": {
    "nextjs": "presentation only; preview/role UI never authorizes server business operations",
    "nestjs": "verifies JWT and requests current local user/context, enforces each action, audits denials",
    "prisma": "queries filtered by organization and permitted scopes; enforce SoD at business transition",
    "supabase": "identity only; no reliance on client-supplied role or custom claims as final business authority"
  }
