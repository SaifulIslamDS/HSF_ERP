  "roles": {
    "canonical_catalogue": "docs/RBAC-AND-APPROVALS.md",
    "ui_role_profiles": "apps/web/src/lib/portal-role-access.ts",
    "status": "MAPPING_REQUIRES_REVIEW",
    "rule": "UI role profile does not grant API permission; finance authority is never implied by system-admin rights"
  },
  "scope_requirements": {
    "organization_id": "mandatory",
    "project_id": "as required by resource; deny mismatched or missing assignments",
    "location_id": "as required by resource; deny mismatched or missing assignments",
    "COM": "organizational unit/cost centre, not an active public programme",
    "record": "filter at query AND guard mutations, not merely UI"
  },
  "sensitivity_rules": {
    "INTERNAL": "approved employee scope",
    "CONFIDENTIAL": "specific operational need",
    "RESTRICTED": "explicit fine-grained grant and minimum necessary fields",
    "health_clinical": "Doctor/authorized clinical role only; finance receives no clinical details",
    "education_child": "centre/class scoped; no unrestricted photo/guardian access",
    "finance": "financial review does not grant clinical or child-record editing",
    "admin": "configures access; cannot self-grant business approvals or self-approve expenses"
  },
  "auditable_events": [
    "authentication_denied",
    "authorization_denied",
    "user_invitation",
    "user_status_change",
    "role_assignment_change",
    "project_access_change",
    "location_access_change",
    "module_release_change",
    "policy_change",
    "privileged_read",
    "export_request",
    "approval_attempt",
    "delegation_change"
  ],
  "audit_privacy": "Store actor, organization, purpose, action, resource type/id, scope, decision, reason code, timestamps and correlation id; do not log PIN, tokens or sensitive clinical/personal payload.",
  "unresolved_decisions": [
    "canonical role/alias approval",
    "COM exact location and unit master",
    "initial module release approval",
    "audit retention and security event review",
    "JWT issuer/JWKS and MFA policy",
    "provisioning, allowlist and revocation policy",
    "emergency access / break-glass policy",
    "sensitivity grants per business record"
  ],
  "implementation_state": "CONTRACT_ONLY; no guard or persistence implementation in v0.1.7",
